{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildingsofttech.vercel.app/apps/app.schema.json",
  "title": "BuildingSoft Tech public app manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "status", "category", "shortDescription", "supportEmail", "publicUrl", "identifiers", "routes", "storeAssets", "locales", "monetization", "releaseReadiness"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2 },
    "status": { "enum": ["concept", "development", "internal-testing", "review", "live", "retired"] },
    "category": { "type": "string", "minLength": 2 },
    "shortDescription": { "type": "string", "minLength": 20, "maxLength": 160 },
    "supportEmail": { "type": "string", "format": "email" },
    "publicUrl": { "type": "string", "format": "uri", "pattern": "^https://buildingsofttech\\.vercel\\.app/apps/" },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["androidPackage", "iosBundle"],
      "properties": { "androidPackage": { "type": ["string", "null"] }, "iosBundle": { "type": ["string", "null"] } }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landing", "privacy", "terms", "refunds", "support", "accountDeletion"],
      "properties": {
        "landing": { "type": "string", "format": "uri", "pattern": "^https://buildingsofttech\\.vercel\\.app/apps/" }, "privacy": { "type": "string", "format": "uri", "pattern": "^https://buildingsofttech\\.vercel\\.app/apps/" }, "terms": { "type": "string", "format": "uri", "pattern": "^https://buildingsofttech\\.vercel\\.app/apps/" }, "refunds": { "type": "string", "format": "uri", "pattern": "^https://buildingsofttech\\.vercel\\.app/apps/" }, "support": { "type": "string", "format": "uri", "pattern": "^https://buildingsofttech\\.vercel\\.app/apps/" }, "accountDeletion": { "type": "string", "format": "uri", "pattern": "^https://buildingsofttech\\.vercel\\.app/apps/" }, "childSafety": { "type": ["string", "null"], "format": "uri", "pattern": "^https://buildingsofttech\\.vercel\\.app/apps/" }
      }
    },
    "storeAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "featureGraphic", "screenshots"],
      "properties": {
        "icon": { "type": ["string", "null"] }, "featureGraphic": { "type": ["string", "null"] }, "screenshots": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["en", "es", "pt", "vi", "id", "fr", "de", "pl", "uk", "ru", "zh", "ja", "ko"] } },
    "monetization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "restorePurchases", "cancelRoute", "refundRoute", "lootBoxes"],
      "properties": { "enabled": { "type": "boolean" }, "restorePurchases": { "type": "boolean" }, "cancelRoute": { "type": "boolean" }, "refundRoute": { "type": "boolean" }, "lootBoxes": { "const": false } }
    },
    "releaseReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "privacy", "terms", "refunds", "support", "accountDeletion", "screenshots"],
      "properties": { "description": { "type": "boolean" }, "privacy": { "type": "boolean" }, "terms": { "type": "boolean" }, "refunds": { "type": "boolean" }, "support": { "type": "boolean" }, "accountDeletion": { "type": "boolean" }, "childSafety": { "type": "boolean" }, "screenshots": { "type": "boolean" } }
    }
  }
}
